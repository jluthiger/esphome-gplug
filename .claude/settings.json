{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run presets)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(node build.mjs)",
      "Bash(esphome config:*)",
      "Bash(esphome compile:*)",
      "Bash(./sizes.sh)",
      "Bash(firmware/sizes.sh)",
      "Bash(python3 tools/size_report.py:*)",
      "Bash(python3 firmware/tools/size_report.py:*)",
      "Bash(./run.sh:*)",
      "Bash(firmware/test/run.sh:*)",
      "Bash(clang++ -std=c++17:*)",
      "Bash(gzip -dc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(esphome run:*)",
      "Bash(esphome upload:*)",
      "Bash(esptool:*)",
      "Bash(esptool.py:*)",
      "Bash(git tag:*)",
      "Bash(git push origin v*)",
      "Bash(git push --tags:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)"
    ],
    "deny": [
      "Read(./firmware/test/captures/*.key)",
      "Read(./firmware/secrets.yaml)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/host-tests-on-edit.sh\"",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-md-drift.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/stale-spa-bundle.sh\""
          }
        ]
      }
    ]
  }
}
